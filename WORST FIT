
#include <stdio.h>

int main() {
    printf("Roll no: 25071A6241 \n");

    int nb, np, b[10], p[10], alloc[10];

    printf("Enter number of memory blocks: ");
    scanf("%d", &nb);

    printf("Enter block sizes:\n");
    for(int i = 0; i < nb; i++)
        scanf("%d", &b[i]);

    printf("Enter number of processes: ");
    scanf("%d", &np);

    printf("Enter process sizes:\n");
    for(int i = 0; i < np; i++) {
        scanf("%d", &p[i]);
        alloc[i] = -1;
    }

    for(int i = 0; i < np; i++) {
        int worst = -1;

        for(int j = 0; j < nb; j++) {
            if(b[j] >= p[i]) {
                if(worst == -1 || b[j] > b[worst])
                    worst = j;
            }
        }

        if(worst != -1) {
            alloc[i] = worst;
            b[worst] -= p[i];
        }
    }

    printf("\nProcess\tSize\tBlock\n");

    for(int i = 0; i < np; i++) {
        if(alloc[i] != -1)
            printf("P%d\t%d\tB%d\n", i+1, p[i], alloc[i]+1);
        else
            printf("P%d\t%d\tNot Allocated\n", i+1, p[i]);
    }

    return 0;
}
