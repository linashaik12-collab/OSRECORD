#include <stdio.h>

int main() {
    printf("Roll no: 25071A6241\n");

    int b, p, i, j;
    int block[10], process[10], alloc[10];
    int frag[10];

    printf("Enter number of memory blocks: ");
    scanf("%d", &b);

    printf("Enter block sizes:\n");
    for (i = 0; i < b; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &p);

    printf("Enter process sizes:\n");
    for (i = 0; i < p; i++) {
        scanf("%d", &process[i]);
        alloc[i] = -1;
        frag[i] = 0;
    }

    for (i = 0; i < p; i++) {
        for (j = 0; j < b; j++) {
            if (block[j] >= process[i]) {
                alloc[i] = j;
                frag[i] = block[j] - process[i];
                block[j] = 0;
                break;
            }
        }
    }

    printf("\nProcess\tProcess Size\tBlock Size\tBlock No.\tInternal Fragmentation\n");

    for (i = 0; i < p; i++) {
        if (alloc[i] != -1) {
            printf("P%d\t%d\t\t%d\t\tB%d\t\t%d\n",
                   i + 1, process[i],
                   process[i] + frag[i],
                   alloc[i] + 1, frag[i]);
        } else {
            printf("P%d\t%d\t\t-\t\tNot Allocated\t-\n",
                   i + 1, process[i]);
        }
    }

    return 0;
}
