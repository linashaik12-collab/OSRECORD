
#include <stdio.h>

int main() {
    printf("Roll no: 25071A6241 \n");

    int nb, np, b[10], p[10], alloc[10], frag[10];

    printf("Enter number of memory blocks: ");
    scanf("%d", &nb);

    printf("Enter block sizes:\n");
    for(int i = 0; i < nb; i++)
        scanf("%d", &b[i]);

    printf("Enter number of processes: ");
    scanf("%d", &np);

    printf("Enter process sizes:\n");
    for(int i = 0; i < np; i++) {
        scanf("%d", &p[i]);
        alloc[i] = -1;
        frag[i] = 0;
    }

    for(int i = 0; i < np; i++) {
        int best = -1;

        for(int j = 0; j < nb; j++) {
            if(b[j] >= p[i]) {
                if(best == -1 || b[j] < b[best])
                    best = j;
            }
        }

        if(best != -1) {
            alloc[i] = best;
            frag[i] = b[best] - p[i];
            b[best] = -1;
        }
    }

    printf("\nProcess\tP.Size\tBlock\tB.Size\tInternal Fragmentation\n");

    for(int i = 0; i < np; i++) {
        if(alloc[i] != -1)
            printf("P%d\t%d\tB%d\t%d\t%d\n",
                   i+1, p[i], alloc[i]+1,
                   p[i] + frag[i], frag[i]);
        else
            printf("P%d\t%d\tNot Allocated\t-\t-\n",
                   i+1, p[i]);
    }

    return 0;
}
